{
  "manifest_version": 3,
  "name": "Bulby for ChatGPT",
  "version": "0.1.0",
  "description": "Send explicit Bulby Ask requests to your selected ChatGPT tab.",
  "permissions": ["storage", "tabs"],
  "host_permissions": ["http://127.0.0.1:8766/*"],
  "background": { "service_worker": "background.js" },
  "icons": { "16": "icons/bulby-16.png", "32": "icons/bulby-32.png", "48": "icons/bulby-48.png", "128": "icons/bulby-128.png" },
  "action": { "default_popup": "popup.html", "default_icon": { "16": "icons/bulby-16.png", "32": "icons/bulby-32.png" } },
  "content_scripts": [{ "matches": ["https://chatgpt.com/*"], "js": ["content.js"] }]
}
